ENV/

# Variables d'environnement / secrets (à injecter au runtime, pas dans l'image)
.env
.env.*
!.env.example

# Python bytecode et cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Tests et coverage
.pytest_cache/
.coverage
htmlcov/
tests/
.tox/
.mypy_cache/
.ruff_cache/

# Bases de données locales
*.db
*.sqlite3

# Logs
*.log
logs/

# IDE / éditeurs
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation / fichiers non nécessaires au build
README.md
docs/
*.md

# Docker lui-même (pas besoin dans l'image)
Dockerfile
docker-compose.yml
.dockerignore

# Divers
*.pid
.cache/
node_modules/